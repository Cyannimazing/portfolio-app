# Final public origin. Rebuild after changing this value.
# cyril.ai is the current candidate; connect the domain before launch.
NEXT_PUBLIC_SITE_URL=https://cyril.ai

# Set false for staging outside Vercel. Vercel previews are always noindex.
SITE_INDEXING_ENABLED=true

# Optional ownership verification tokens (not API keys).
# Paste only the content value from the search engine's verification meta tag.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
